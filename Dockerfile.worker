# Worker for hosts without Docker-in-Docker (Railway, Fly.io, Render):
# site builds are checked on Vercel (SANDBOX=vercel), so no Docker CLI is needed here.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .

ENV SANDBOX=vercel \
    WORKER_CONCURRENCY=4 \
    PYTHONUNBUFFERED=1
CMD ["tpf-worker"]
