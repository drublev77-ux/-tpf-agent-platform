# --- Database ---
DATABASE_URL=postgresql://tpf:tpf@localhost:5432/tpf

# --- Access ---
# Operator token for /admin endpoints (escalations, resume, payments). Generate: openssl rand -hex 32
ADMIN_TOKEN=change-me

# --- LLM gateway (Anthropic Messages API) ---
ANTHROPIC_API_KEY=
# Model per role class; change here, not in code.
MODEL_STRONG=claude-opus-5-5
MODEL_CODE=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5-20251001
# The reviewer must use a different model than the author it checks.
MODEL_REVIEWER=claude-opus-5-5
# Optional: price per million tokens, to report cost in money. Leave 0 to track tokens only.
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0

# --- Budgets and limits ---
ORDER_TOKEN_BUDGET=2000000
MAX_CHECK_ATTEMPTS=3
MAX_REVIEW_ROUNDS=2
TASK_MAX_RETRIES=3

# --- Pricing of client orders ---
HOURLY_RATE=40
CURRENCY=USD
# Payments: off | stripe | manual (operator confirms bank transfers via /admin/orders/{id}/payment).
# Set the same PAYMENT_PROVIDER and PREPAYMENT_SHARE on the API and the worker.
PAYMENT_PROVIDER=off
# 0.5 = 50% before work + 50% before release; 1 = all upfront; 0 = all before release
PREPAYMENT_SHARE=0.5
# Worker: creates Checkout links. API: verifies webhooks (endpoint /webhooks/stripe).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public URL of the API, used for the pages Stripe returns the client to.
PUBLIC_BASE_URL=https://tpf-agent-platform.vercel.app

# --- Sandbox for builds and tests: docker | local ---
SANDBOX=docker
SANDBOX_IMAGE=node:22-alpine
SANDBOX_TIMEOUT_SEC=900

# --- Delivery ---
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Optional: push each order's code to its own private GitHub repo.
GITHUB_TOKEN=
GITHUB_OWNER=

# --- Client notifications: log | webhook ---
NOTIFIER=log
NOTIFY_WEBHOOK_URL=
